source 'https://rubygems.org'

# Patched ActiveSupport releases used by current CocoaPods require Ruby 3.1+.
ruby ">= 3.1.0"

# Keep the iOS toolchain on patched, mutually compatible release lines.
gem 'cocoapods', '>= 1.17.0', '< 2.0'
gem 'activesupport', '>= 7.2.3.1', '< 8.0'
gem 'xcodeproj', '>= 1.28.1', '< 2.0'
gem 'concurrent-ruby', '>= 1.3.7', '< 2.0'

# Ruby 3.4.0 has removed some libraries from the standard library.
gem 'bigdecimal'
gem 'logger'
gem 'benchmark'
gem 'mutex_m'
gem 'nkf'
